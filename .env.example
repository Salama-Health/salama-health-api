# Copy to .env and fill in. NEVER commit the real .env.

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=false

# ── Database (local PostgreSQL) ──────────────────────────────────────────────
# Local dev (running Postgres on the host):
DATABASE_URL=postgresql+psycopg2://salama:salama@localhost:5432/salama
# Inside docker-compose the host is the service name `db`:
# DATABASE_URL=postgresql+psycopg2://salama:salama@db:5432/salama

# Used by the postgres container in docker-compose
POSTGRES_USER=salama
POSTGRES_PASSWORD=salama
POSTGRES_DB=salama

# Connection pool (keep workers * (POOL_SIZE+MAX_OVERFLOW) < postgres max_connections)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-to-a-long-random-string

# ── Server / scaling ─────────────────────────────────────────────────────────
WEB_CONCURRENCY=4                # number of Gunicorn/Uvicorn workers
LOG_LEVEL=info

# ── ML models (loaded locally from MODELS_DIR) ───────────────────────────────
MODELS_DIR=./models
# Optional fallback: download models from HF Hub if not found locally
HF_MODEL_REPO=MubarakB/salama-cdi-models
# Set true in production to fail startup if no models are found
REQUIRE_MODELS=false

# ── Scoring scheduler (weekly CDI pipeline) ──────────────────────────────────
ENABLE_SCHEDULER=true            # set false if using external cron + refresh_scores.py
CDI_REFRESH_CRON_DAY=sun         # sun..sat — weekly run day
CDI_REFRESH_CRON_HOUR=0
CDI_REFRESH_CRON_MINUTE=0

# ── Climate ingestion sources ────────────────────────────────────────────────
# Open-Meteo + CHIRPS need outbound HTTPS. Pilot states whose counties we ingest.
PILOT_STATES=Unity,Jonglei,Upper Nile
OPEN_METEO_TIMEZONE=Africa/Nairobi
OPEN_METEO_REQUEST_DELAY_S=2.0   # ~30 req/min free-tier limit

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated. Use the app's origin in production instead of *.
CORS_ORIGINS=*
