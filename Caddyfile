# TLS terminator and reverse proxy.
#
# Caddy obtains and renews the Let's Encrypt certificate for this hostname on
# its own, over the ACME HTTP-01 challenge on port 80 - which is why port 80
# must stay open in the security group even after HTTPS works. Renewal is
# automatic and needs no cron.
#
# Certificates and ACME account keys live in the caddy_data volume, NOT in the
# repo, so they survive both deploys (rsync --delete) and container rebuilds.
# Losing that volume means re-issuing, which Let's Encrypt rate-limits.

salamahealth.duckdns.org {
	encode gzip

	# Matches the old nginx client_max_body_size 10m.
	request_body {
		max_size 10MB
	}

	# Health checks are noisy and uninteresting in the access log.
	@health path /health
	log_skip @health

	reverse_proxy api:8000 {
		header_up X-Real-IP {remote_host}
		# Caddy sets X-Forwarded-For and X-Forwarded-Proto automatically.
	}
}
